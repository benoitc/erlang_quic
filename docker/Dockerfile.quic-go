# quic-go HTTP/3 server for interoperability testing
FROM golang:1.24-alpine AS builder

RUN apk add --no-cache git

WORKDIR /build

# v0.48.x builds with Go 1.22+. ./example is the long-running HTTP/3
# server; ./example/echo is a self-contained demo that exits.
RUN git clone --depth 1 --branch v0.48.2 https://github.com/quic-go/quic-go.git && \
    cd quic-go && \
    go build -o /build/h3server ./example

# Runtime image
FROM alpine:latest

RUN apk add --no-cache ca-certificates

COPY --from=builder /build/h3server /usr/local/bin/h3server

RUN mkdir -p /certs

WORKDIR /app

EXPOSE 4434/udp

ENTRYPOINT ["/usr/local/bin/h3server"]
CMD ["-bind", "0.0.0.0:4434", "-cert", "/certs/cert.pem", "-key", "/certs/priv.key"]
