{application, quic, [
    {description, "Pure Erlang QUIC implementation (RFC 9000)"},
    {vsn, "2.1.0"},
    {registered, [
        quic_sup,
        quic_server_registry,
        quic_server_sup,
        quic_token_cache,
        quic_conn_sup,
        quic_happy_sup,
        quic_dist_sup,
        quic_dist_tickets
    ]},
    {mod, {quic_app, []}},
    {applications, [
        kernel,
        stdlib,
        crypto,
        ssl
    ]},
    {env, [
        %% Distribution configuration
        %% {dist, [
        %%   {cert_file, "/path/to/cert.pem"},
        %%   {key_file, "/path/to/key.pem"},
        %%   {cacert_file, "/path/to/ca.pem"},
        %%   {verify, verify_peer},
        %%   {discovery_module, quic_discovery_static},
        %%   {nodes, [{'node1@host1', {"192.168.1.1", 4433}}]},
        %%   {nat_enabled, false}
        %% ]}
    ]},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    %% rebar3_hex reads package paths from here, not from rebar.config.
    %% README's image ships so the Hex.pm page does not show it broken;
    %% the CMake build directory is git-ignored but would be packed.
    {include_paths, ["docs/images/enki-multimedia.svg"]},
    {exclude_paths, ["c_src/build"]},
    {links, [
        {"GitHub", "https://github.com/benoitc/erlang_quic"}
    ]}
]}.
